<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ biz.name }} — {{ biz.category|title }}{% if biz.city %} in {{ biz.city }}{% endif %}</title>
<meta name="description" content="{{ meta_description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": {{ biz.name|tojson }},
  "telephone": {{ (biz.phone or '')|tojson }},
  "address": { "@type": "PostalAddress", "streetAddress": {{ (biz.address or '')|tojson }} }
  {%- if biz.rating %},
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ biz.rating }}, "reviewCount": {{ biz.reviews or 0 }} }
  {%- endif %}
}
</script>
<style>
  :root{
    --ink:#12151c; --muted:#5b6472; --line:#e6e9ef; --bg:#ffffff; --soft:#f6f7f9;
    --brand:{{ brand }}; --brand-ink:{{ brand_ink }}; --radius:14px;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --ink:#eef1f6; --muted:#a2acbb; --line:#232833; --bg:#0d1017; --soft:#141922;
    }
  }
  :root[data-theme="dark"]{
    --ink:#eef1f6; --muted:#a2acbb; --line:#232833; --bg:#0d1017; --soft:#141922;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
       font:16px/1.65 Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
       -webkit-font-smoothing:antialiased}
  .wrap{max-width:1080px;margin:0 auto;padding:0 16px}
  h1,h2,h3{font-family:Fraunces,Georgia,serif;line-height:1.12;margin:0 0 .4em;
           letter-spacing:-.01em;font-weight:700}
  h1{font-size:clamp(2.1rem,6vw,3.6rem)}
  h2{font-size:clamp(1.5rem,3.6vw,2.2rem)}
  p{margin:0 0 1em;color:var(--muted)}
  a{color:inherit}

  header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);
         backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .bar{display:flex;align-items:center;gap:16px;height:64px}
  .logo{font-family:Fraunces,serif;font-weight:700;font-size:1.15rem;letter-spacing:-.01em}
  .bar nav{margin-left:auto;display:flex;gap:22px;font-size:.93rem;color:var(--muted)}
  .bar nav a{text-decoration:none}
  .bar nav a:hover{color:var(--ink)}
  .cta{display:inline-flex;align-items:center;gap:8px;background:var(--brand);
       color:var(--brand-ink);padding:11px 20px;border-radius:999px;font-weight:600;
       text-decoration:none;font-size:.95rem;white-space:nowrap}
  .cta:hover{filter:brightness(.94)}
  @media(max-width:720px){ .bar nav{display:none} }

  .hero{padding:72px 0 56px;display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
  @media(max-width:860px){ .hero{grid-template-columns:1fr;padding:44px 0 36px;gap:28px} }
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.8rem;font-weight:600;
           letter-spacing:.08em;text-transform:uppercase;color:var(--brand-ink);
           background:var(--brand);padding:6px 13px;border-radius:999px;margin-bottom:18px}
  .lede{font-size:1.12rem;max-width:46ch}
  .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
  .ghost{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:999px;
         border:1px solid var(--line);text-decoration:none;font-weight:500;font-size:.95rem}

  .shot{aspect-ratio:4/3;border-radius:var(--radius);overflow:hidden;background:var(--soft);
        border:1px solid var(--line)}
  .shot img{width:100%;height:100%;object-fit:cover;display:block}
  .shot.ph{display:grid;place-items:center;color:var(--muted);font-size:.9rem}

  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);
         border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin:8px 0 64px}
  .stat{background:var(--bg);padding:22px 18px;text-align:center}
  .stat b{display:block;font-family:Fraunces,serif;font-size:1.7rem;line-height:1}
  .stat span{font-size:.82rem;color:var(--muted)}
  @media(max-width:620px){ .stats{grid-template-columns:1fr;} }

  section{padding:56px 0;border-top:1px solid var(--line)}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
  @media(max-width:860px){ .grid3{grid-template-columns:1fr} }
  .card{border:1px solid var(--line);border-radius:var(--radius);padding:22px;background:var(--soft)}
  .card h3{font-size:1.1rem;margin-bottom:.35em}
  .card p{margin:0;font-size:.95rem}

  .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}
  @media(max-width:720px){ .gallery{grid-template-columns:repeat(2,1fr)} }
  .gallery div{aspect-ratio:1;border-radius:10px;overflow:hidden;background:var(--soft);
               border:1px solid var(--line)}
  .gallery img{width:100%;height:100%;object-fit:cover;display:block}

  .split{display:grid;grid-template-columns:1fr 1fr;gap:40px}
  @media(max-width:860px){ .split{grid-template-columns:1fr;gap:24px} }
  .hours{list-style:none;padding:0;margin:0;font-size:.95rem}
  .hours li{display:flex;justify-content:space-between;gap:16px;padding:9px 0;
            border-bottom:1px solid var(--line);color:var(--muted)}
  .hours li:last-child{border-bottom:0}

  footer{border-top:1px solid var(--line);padding:34px 0;color:var(--muted);font-size:.9rem}
  .note{margin-top:14px;padding:14px 16px;border:1px dashed var(--line);border-radius:10px;
        font-size:.85rem;color:var(--muted);background:var(--soft)}
  .float{position:fixed;right:16px;bottom:16px;z-index:30}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <div class="logo">{{ biz.name }}</div>
    <nav>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#visit">Visit</a>
    </nav>
    {% if biz.phone %}<a class="cta" href="tel:{{ biz.phone_e164 or biz.phone }}">Call now</a>{% endif %}
  </div>
</header>

<main class="wrap">

  <div class="hero">
    <div>
      <span class="eyebrow">{{ biz.category|title }}{% if biz.city %} · {{ biz.city }}{% endif %}</span>
      <h1>{{ headline }}</h1>
      <p class="lede">{{ subhead }}</p>
      <div class="actions">
        {% if biz.phone %}<a class="cta" href="tel:{{ biz.phone_e164 or biz.phone }}">Call {{ biz.phone }}</a>{% endif %}
        {% if biz.phone_e164 %}<a class="ghost" href="https://wa.me/{{ biz.phone_e164|replace('+','') }}">WhatsApp us</a>{% endif %}
        <a class="ghost" href="#visit">Find us</a>
      </div>
    </div>
    <div class="shot{% if not photos %} ph{% endif %}">
      {% if photos %}<img src="{{ photos[0] }}" alt="{{ biz.name }}">{% else %}Your photo here{% endif %}
    </div>
  </div>

  {% if biz.rating or biz.reviews %}
  <div class="stats">
    {% if biz.rating %}<div class="stat"><b>{{ '%.1f'|format(biz.rating) }}★</b><span>Google rating</span></div>{% endif %}
    {% if biz.reviews %}<div class="stat"><b>{{ biz.reviews }}</b><span>customer reviews</span></div>{% endif %}
    <div class="stat"><b>{{ biz.city or 'Local' }}</b><span>serving the area</span></div>
  </div>
  {% endif %}

  <section id="services">
    <h2>What we do</h2>
    <p>{{ services_lede }}</p>
    <div class="grid3">
      {% for s in services %}
      <div class="card"><h3>{{ s.title }}</h3><p>{{ s.body }}</p></div>
      {% endfor %}
    </div>
  </section>

  {% if photos|length > 1 %}
  <section id="gallery">
    <h2>A look inside</h2>
    <div class="gallery">
      {% for p in photos[1:7] %}<div><img src="{{ p }}" alt="{{ biz.name }}" loading="lazy"></div>{% endfor %}
    </div>
  </section>
  {% endif %}

  <section id="visit">
    <div class="split">
      <div>
        <h2>Come and see us</h2>
        {% if biz.address %}<p>{{ biz.address }}</p>{% endif %}
        {% if biz.phone %}<p><strong>Phone:</strong> <a href="tel:{{ biz.phone_e164 or biz.phone }}">{{ biz.phone }}</a></p>{% endif %}
        <div class="actions">
          {% if maps_url %}<a class="cta" href="{{ maps_url }}">Get directions</a>{% endif %}
        </div>
      </div>
      <div id="about">
        <h2>Opening hours</h2>
        {% if hours %}
        <ul class="hours">{% for h in hours %}<li><span>{{ h.split(':')[0] }}</span><span>{{ h.split(':',1)[1] if ':' in h else '' }}</span></li>{% endfor %}</ul>
        {% else %}
        <p>Open six days a week. Call ahead and we will make time for you.</p>
        {% endif %}
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="wrap">
    <div>© {{ year }} {{ biz.name }}{% if biz.city %} · {{ biz.city }}{% endif %}</div>
    <div class="note">{{ demo_note }}</div>
  </div>
</footer>

{% if biz.phone_e164 %}
<a class="cta float" href="https://wa.me/{{ biz.phone_e164|replace('+','') }}">Message us</a>
{% endif %}

</body>
</html>
